# Upstash Redis REST credentials (required for the live usage counter and rate limiter)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional compatibility aliases for Vercel KV deployments
# KV_REST_API_URL=
# KV_REST_API_TOKEN=

# Optional POST /api/uses fixed-window limit. Invalid or out-of-range values use defaults.
# Defaults: 30 requests per 60 seconds. Maximums: 10,000 requests and 3,600 seconds.
USAGE_RATE_LIMIT_MAX=30
USAGE_RATE_LIMIT_WINDOW_SECONDS=60
